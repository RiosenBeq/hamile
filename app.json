{
  "expo": {
    "name": "Marigold",
    "slug": "marigold",
    "scheme": "marigold",
    "version": "1.0.0",
    "owner": "marigold",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FBF7F2"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "app.marigold.companion",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Marigold uses the camera to scan food labels, menus, medication packs and product ingredients so we can give you a calm safety verdict.",
        "NSMicrophoneUsageDescription": "Marigold uses the microphone when you ask a question out loud about something you're holding.",
        "NSPhotoLibraryUsageDescription": "Marigold uses your photo library when you pick an existing photo of a label, menu or product to scan.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:marigold.app"]
    },
    "android": {
      "package": "app.marigold.companion",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7F2"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "marigold.app", "pathPrefix": "/j" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Marigold uses the camera to scan food, menus and labels for safety guidance during your pregnancy.",
          "microphonePermission": "Marigold uses the microphone when you ask a question out loud."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/splash.png",
          "resizeMode": "cover"
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "00000000-0000-0000-0000-000000000000" },
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "anthropicApiKey": ""
    }
  }
}
