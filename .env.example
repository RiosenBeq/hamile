# Marigold env. Copy to `.env` and fill in for cloud features.
# When unset the app runs fully offline (AsyncStorage only) and uses local
# mock verdicts and canned chat responses.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side OpenAI key — used by the verdict / chat edge functions.
# Set this in your edge function env, NOT in the client.
OPENAI_API_KEY=

# Dev-only client-side OpenAI key — used by Marigold AI for chat and photo
# vision analysis. EXPO_PUBLIC_* vars ship in the JS bundle, so anyone with
# the app can extract this — fine for personal dev builds, NEVER use in a
# published build. For production route through the Supabase edge function.
EXPO_PUBLIC_OPENAI_API_KEY=

# Used by `expo-router` deep links + partner share QR codes.
EXPO_PUBLIC_APP_URL=https://marigold.app
