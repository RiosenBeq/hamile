# Marigold env. Copy to `.env` and fill in for cloud features.
# When unset the app runs fully offline (AsyncStorage only) and uses local mock verdicts.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic key is used only by the verdict edge function (or your own backend).
# DO NOT ship this in the client bundle in production - put it in the edge function env.
ANTHROPIC_API_KEY=

# Used by `expo-router` deep links + partner share QR codes.
EXPO_PUBLIC_APP_URL=https://marigold.app
